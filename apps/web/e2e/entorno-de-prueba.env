# Entorno de los tests de navegador. TODO es de mentira, y a propósito.
#
# La API y Supabase apuntan al simulador local (e2e/simulador/servidor.ts):
# ninguna prueba puede alcanzar la base de producción, aunque alguien escriba
# mal un test. `test:e2e` compila la web con ESTE archivo y no con el `.env`
# de la raíz, que en la máquina de desarrollo tiene las credenciales reales.
#
# No poner nunca un valor real acá: este archivo se commitea.
NEXT_PUBLIC_API_URL=http://localhost:3291
NEXT_PUBLIC_SUPABASE_URL=http://localhost:3292
NEXT_PUBLIC_SUPABASE_ANON_KEY=clave-de-mentira
