// Esquema Prisma — Núcleo de plataforma (Paso 2).
// Modelo de datos: docs/MODELO_DATOS_TABLERO.md (Parte A).
// Aislamiento multi-tenant garantizado por RLS (ver migración SQL de policies).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooler (6543) — runtime
  directUrl = env("DIRECT_URL") // directa (5432) — migraciones
}

/// Inmobiliaria (tenant). El aislamiento se aplica sobre `id`.
model Tenant {
  id        String   @id @default(uuid()) @db.Uuid
  nombre    String
  slug      String   @unique
  plan      String   @default("basico") // etiqueta comercial: basico | profesional | enterprise
  // Módulos habilitados ("prendido / pagado"), fuente de verdad de permisos —
  // ModulosTenantSchema. El plan quedó como rótulo, sin efecto en accesos.
  modulos   Json     @default("{\"tablero\": true, \"tasador\": false, \"todo\": false, \"protocolo\": false, \"publicacion\": false, \"alquileres\": false}")
  estado    String   @default("activo") // activo | suspendido
  config    Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  usuarios                 Usuario[]
  usuarioRoles             UsuarioRol[]
  operaciones              Operacion[]
  puntas                   OperacionPunta[]
  objetivos                Objetivo[]
  tasaciones               Tasacion[]
  tasacionComparables      TasacionComparable[]
  tasacionFotos            TasacionFoto[]
  tasacionEstadoHistorials TasacionEstadoHistorial[]
  informeGenerados         InformeGenerado[]
  googleCuentas            GoogleCuenta[]
  integracionCredenciales  IntegracionCredencial[]
  propiedades              Propiedad[]
  protocolos               Protocolo[]
  protocoloAcciones        ProtocoloAccion[]
  alqPersonas              AlqPersona[]
  alqPropiedades           AlqPropiedad[]
  alqContratos             AlqContrato[]
  alqContratoPartes        AlqContratoParte[]
  alqTramos                AlqTramo[]
  alqConceptos             AlqConcepto[]
  alqCobros                AlqCobro[]
  alqImputaciones          AlqImputacion[]
  alqLiquidaciones         AlqLiquidacion[]
  alqDocumentos            AlqDocumento[]
  alqFirmantes             AlqFirmante[]
  alqFirmaEventos          AlqFirmaEvento[]

  @@map("tenant")
}

/// Usuario. `id` coincide con el user id de Supabase Auth.
model Usuario {
  id                   String   @id @db.Uuid
  tenantId             String   @map("tenant_id") @db.Uuid
  nombre               String
  email                String
  estado               String   @default("activo") // activo | inactivo
  liderId              String?  @map("lider_id") @db.Uuid // Team Leader del que depende
  // Id del usuario en Supabase Auth — null para vendedores creados desde el
  // Tablero (registros de datos sin acceso todavía, ver VendedoresService).
  // Se "activa" el acceso creándole una cuenta real y seteando este campo,
  // sin tocar `id` (que sigue siendo la PK usada en todas las FKs de negocio).
  authUserId           String?  @unique @map("auth_user_id") @db.Uuid
  // Foto de perfil (usuarios-avatares en Supabase Storage) — se carga desde
  // /admin, sin restricción de tamaño más allá de la que ya valida el upload.
  fotoUrl              String?  @map("foto_url")
  // Teléfono de contacto del agente — se carga desde /admin y aparece en el
  // header del informe de tasación (email · teléfono).
  telefono             String?  @map("telefono")
  /// El implementador da de alta con una clave temporal: hasta que la persona
  /// elija la suya, la app la manda a /cambiar-clave. Se vuelve a marcar cuando
  /// un admin resetea la contraseña (misma situación que el primer ingreso).
  debeCambiarPassword  Boolean  @default(true) @map("debe_cambiar_password")
  /// Recibe el reporte semanal del Protocolo por mail. NO se deriva del rol:
  /// quién recibe un mail es una decisión de negocio, el rol es un permiso.
  /// Arranca apagado — un reporte que nadie pidió se marca como spam.
  recibeReporteSemanal Boolean  @default(false) @map("recibe_reporte_semanal")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant            Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lider             Usuario?                  @relation("Equipo", fields: [liderId], references: [id], onDelete: SetNull)
  equipo            Usuario[]                 @relation("Equipo")
  roles             UsuarioRol[]
  puntas            OperacionPunta[]
  objetivos         Objetivo[]
  tasaciones        Tasacion[]
  historialTasacion TasacionEstadoHistorial[]
  googleCuenta      GoogleCuenta?
  propiedades       Propiedad[]
  protocolos        Protocolo[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([liderId])
  @@map("usuario")
}

/// Asignación de roles (un usuario puede tener uno o más roles en su tenant).
model UsuarioRol {
  usuarioId String @map("usuario_id") @db.Uuid
  rol       String // vendedor | team_leader | direccion | publicador | admin_tenant | admin_plataforma
  tenantId  String @map("tenant_id") @db.Uuid

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([usuarioId, rol])
  @@index([tenantId])
  @@map("usuario_rol")
}

// ============================================================================
// Módulo Tablero Comercial (Paso 3). Modelo: docs/MODELO_DATOS_TABLERO.md (Parte B).
// Enfoque NORMALIZADO: las "puntas" del prototipo (punta_vend/punta_comp) se
// modelan como filas en `operacion_punta`. Ver apps/api/src/modules/tablero/README.md.
// Todas las tablas llevan tenant_id y están protegidas por RLS (migración SQL).
// ============================================================================

/// Operación comercial: cubre ventas y alquileres (diferenciadas por `tipo`).
model Operacion {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  codigo       String // Código legible: OP-1001 (venta) | ALQ-1001 (alquiler)
  /// Parte numérica de `codigo`, para poder ordenar por número y no por texto
  /// ("OP-999" es MAYOR que "OP-1001" si se compara como texto).
  /// La calcula Postgres: es una columna GENERATED ALWAYS. NUNCA escribirla
  /// desde la aplicación — la base rechaza el insert. Ver la migración
  /// 20260728120000_operacion_codigo_num.
  codigoNum    Decimal?  @map("codigo_num") @db.Decimal
  tipo         String // venta | alquiler
  direccion    String
  precio       Decimal?  @db.Decimal(14, 2) // null en alquileres (usan valor_mensual)
  valorMensual Decimal?  @map("valor_mensual") @db.Decimal(14, 2) // solo alquiler
  moneda       String    @default("USD")
  cantPuntas   Int       @map("cant_puntas") // 0 (alquiler) | 1 | 2
  comTotal     Decimal   @default(0) @map("com_total") @db.Decimal(14, 2)
  estado       String // venta: escriturada | senada ; alquiler: firmado
  fechaReserva DateTime? @map("fecha_reserva") @db.Date
  fechaFirma   DateTime? @map("fecha_firma") @db.Date
  mes          Int? // derivado de fecha_firma ?? fecha_reserva (reporting)
  anio         Int? // íd.
  obs          String?
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  puntas OperacionPunta[]

  @@unique([tenantId, codigo])
  @@index([tenantId])
  @@index([tenantId, anio])
  @@index([tenantId, tipo, estado])
  @@map("operacion")
}

/// Punta de una operación (1 o 2 por venta). Atribuye la operación a un agente.
model OperacionPunta {
  id          String  @id @default(uuid()) @db.Uuid
  operacionId String  @map("operacion_id") @db.Uuid
  tenantId    String  @map("tenant_id") @db.Uuid
  lado        String // vendedora (propietario/locador) | compradora (comprador/inquilino)
  usuarioId   String  @map("usuario_id") @db.Uuid
  comision    Decimal @default(0) @db.Decimal(14, 2)

  operacion Operacion @relation(fields: [operacionId], references: [id], onDelete: Cascade)
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([operacionId])
  @@index([usuarioId])
  @@map("operacion_punta")
}

/// Objetivo anual por vendedor (comisión bruta, volumen, puntas).
model Objetivo {
  id          String  @id @default(uuid()) @db.Uuid
  tenantId    String  @map("tenant_id") @db.Uuid
  usuarioId   String  @map("usuario_id") @db.Uuid
  anio        Int
  objComision Decimal @default(0) @map("obj_comision") @db.Decimal(14, 2)
  objVolumen  Decimal @default(0) @map("obj_volumen") @db.Decimal(14, 2)
  objPuntas   Int     @default(0) @map("obj_puntas")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([tenantId, usuarioId, anio])
  @@index([tenantId])
  @@map("objetivo")
}

// ============================================================================
// Módulo Tasador de Propiedades (Sprint 0). Modelo tomado de
// docs/prototipos/tasador_de_propiedades.html (secciones 1-6 del formulario).
// Análisis comercial y estrategia comercial (texto libre) van en Json: no se
// filtran/agregan campo a campo, mismo criterio que Tenant.config.
// ============================================================================

/// Tasación de una propiedad. `estado` es el estado de gestión (workflow);
/// `estadoInmueble` es la condición física declarada del inmueble.
model Tasacion {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  agenteId String  @map("agente_id") @db.Uuid
  codigo   String? // identificador legible opcional (ej. TAS-2026-001), para el seed y referencia humana

  // Sección 1 — Datos del informe
  cliente       String
  fecha         DateTime @db.Date
  direccion     String
  barrio        String?
  ciudad        String?
  tipoOperacion String   @map("tipo_operacion") // venta | alquiler

  // Sección 2 — Características del inmueble
  tipoPropiedad    String   @map("tipo_propiedad") // TipoPropiedadSchema (incluye "PH")
  supCubierta      Decimal  @default(0) @map("sup_cubierta") @db.Decimal(10, 2)
  supSemicubierta  Decimal  @default(0) @map("sup_semicubierta") @db.Decimal(10, 2)
  supDescubierta   Decimal  @default(0) @map("sup_descubierta") @db.Decimal(10, 2)
  supTerreno       Decimal? @map("sup_terreno") @db.Decimal(10, 2)
  superficieTotal  Decimal  @map("superficie_total") @db.Decimal(10, 2) // derivada (@vacker/domain), recalculada en cada write
  // El criterio con el que se calculó ESTA tasación, congelado al crearla.
  // No se lee de la inmobiliaria cada vez: si mañana cambia su criterio, un
  // informe ya entregado al propietario tiene que seguir diciendo lo mismo.
  coefSemicubierta Decimal  @default(1) @map("coef_semicubierta") @db.Decimal(4, 3)
  coefDescubierta  Decimal  @default(0.3) @map("coef_descubierta") @db.Decimal(4, 3)
  dormitorios      Int?
  banos            Int?
  toilette         Int?
  ambientes        Int?
  antiguedad       Int?
  estadoInmueble   String?  @map("estado_inmueble")
  disposicion      String?
  orientacion      String?
  cochera          Boolean  @default(false)
  balcon           Boolean  @default(false)
  terraza          Boolean  @default(false)
  patio            Boolean  @default(false)
  lavadero         Boolean  @default(false)
  /// Pileta PROPIA de la unidad. La compartida del edificio va en `amenities`.
  piscina          Boolean  @default(false)
  altillo          Boolean  @default(false)
  baulera          Boolean  @default(false)
  biblioteca       Boolean  @default(false)
  escritorio       Boolean  @default(false)
  jardin           Boolean  @default(false)
  vestidor         Boolean  @default(false)
  /// ServicioSchema[] — lista cerrada, ver packages/types/src/tasador.ts
  servicios        String[] @default([])
  /// El "¿tiene amenities?" del formulario. Se guarda aparte de la lista para
  /// distinguir "dijo que no" de "no lo completó".
  tieneAmenities   Boolean  @default(false) @map("tiene_amenities")
  /// AmenitySchema[], pero sin constraint: antes era texto libre y hay
  /// tasaciones cargadas con valores fuera de la lista. Se conservan.
  amenities        String[] @default([])
  detalleAmenities String?  @map("detalle_amenities")
  expensas         Decimal? @db.Decimal(10, 2)
  aptoCredito      String?  @map("apto_credito")
  documentacion    String?

  // Sección 3 — Análisis comercial (texto libre, sin agregación individual)
  analisisComercial Json? @map("analisis_comercial")

  // Sección 5 — Valores de tasación (auto-calculados con @vacker/domain, editables)
  valorMinimo          Decimal? @map("valor_minimo") @db.Decimal(14, 2)
  valorRecomendado     Decimal? @map("valor_recomendado") @db.Decimal(14, 2)
  valorAspiracional    Decimal? @map("valor_aspiracional") @db.Decimal(14, 2)
  margenNegociacion    Decimal? @map("margen_negociacion") @db.Decimal(5, 2)
  escenarioRecomendado String?  @map("escenario_recomendado")
  plazoEstimado        String?  @map("plazo_estimado")

  // Sección 6 — Estrategia comercial (texto libre)
  estrategiaComercial Json? @map("estrategia_comercial")

  // Estado de gestión (workflow) — ver TasacionEstadoHistorial para la auditoría
  estado          String  @default("En proceso") // EstadoTasacionSchema
  exclusividad    Json? // { tipo: 'exclusiva', dias } | { tipo: 'no' } — exigido al pasar a "Captada"
  motivoNoCaptada String? @map("motivo_no_captada") // MotivoNoCaptadaSchema — exigido al pasar a "No captada"

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant      Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agente      Usuario                   @relation(fields: [agenteId], references: [id], onDelete: Restrict)
  comparables TasacionComparable[]
  fotos       TasacionFoto[]
  historial   TasacionEstadoHistorial[]
  informes    InformeGenerado[]
  protocolo   Protocolo?

  @@unique([tenantId, codigo])
  @@index([tenantId])
  @@index([tenantId, agenteId])
  @@index([tenantId, estado])
  @@map("tasacion")
}

/// Comparable de mercado cargado a mano (1..6 por tasación, validado en Zod).
model TasacionComparable {
  id              String    @id @default(uuid()) @db.Uuid
  tasacionId      String    @map("tasacion_id") @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  direccion       String
  tipoComp        String    @default("Departamento") @map("tipo_comp")
  superficie      Decimal   @db.Decimal(10, 2) // superficie de valuación (cubierta + semi + descubierta×0.3); USD/m² = precio/superficie
  supCubierta     Decimal?  @map("sup_cubierta") @db.Decimal(10, 2)
  supSemi         Decimal?  @map("sup_semi") @db.Decimal(10, 2)
  supDescubierta  Decimal?  @map("sup_descubierta") @db.Decimal(10, 2)
  supTerreno      Decimal?  @map("sup_terreno") @db.Decimal(10, 2)
  precio          Decimal   @db.Decimal(14, 2)
  dormitorios     Int?
  banos           Int?
  antiguedad      Int? // años de antigüedad del comparable (se muestra en el informe)
  cochera         Boolean   @default(false)
  estado          String?
  fuente          String    @default("Publicación")
  tipoPrecio      String    @default("Publicado") @map("tipo_precio")
  fechaReferencia DateTime? @map("fecha_referencia") @db.Date
  distanciaKm     Decimal?  @map("distancia_km") @db.Decimal(8, 2)
  link            String?
  observaciones   String?

  tasacion Tasacion @relation(fields: [tasacionId], references: [id], onDelete: Cascade)
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tasacionId])
  @@map("tasacion_comparable")
}

/// Fotos de la propiedad (hasta 3, Sprint 5). Tabla creada en Sprint 0.
model TasacionFoto {
  id         String @id @default(uuid()) @db.Uuid
  tasacionId String @map("tasacion_id") @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid
  url        String
  orden      Int    @default(0)

  tasacion Tasacion @relation(fields: [tasacionId], references: [id], onDelete: Cascade)
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tasacionId])
  @@map("tasacion_foto")
}

/// Auditoría de cambios de estado (Sprint 3 los escribe; tabla creada ahora).
model TasacionEstadoHistorial {
  id             String   @id @default(uuid()) @db.Uuid
  tasacionId     String   @map("tasacion_id") @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  estadoAnterior String?  @map("estado_anterior")
  estadoNuevo    String   @map("estado_nuevo")
  usuarioId      String   @map("usuario_id") @db.Uuid
  detalle        Json? // exclusividad u motivo del cambio, si aplica
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tasacion Tasacion @relation(fields: [tasacionId], references: [id], onDelete: Cascade)
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  usuario  Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([tasacionId])
  @@map("tasacion_estado_historial")
}

/// Informe de tasación generado en PDF (Sprint 2/5 lo puebla; tabla creada ahora).
model InformeGenerado {
  id         String   @id @default(uuid()) @db.Uuid
  tasacionId String   @map("tasacion_id") @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  url        String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tasacion Tasacion @relation(fields: [tasacionId], references: [id], onDelete: Cascade)
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tasacionId])
  @@map("informe_generado")
}

// ============================================================================
// Módulo To Do List — espejo de solo lectura de Google Calendar.
// Una fila por usuario que conectó su cuenta de Google. El refresh token se
// guarda ENCRIPTADO (AES-256-GCM), nunca en claro. Cada usuario ve solo su
// propio calendario (RLS por tenant + filtro por usuario_id en la query).
// ============================================================================

/// Conexión OAuth de un usuario con Google (para leer su Calendar principal).
/// Credenciales de integraciones de terceros, una fila por inmobiliaria y
/// proveedor. Hoy solo Tokko Broker; la tabla es genérica porque el próximo
/// portal va a necesitar lo mismo.
///
/// El secreto va CIFRADO (AES-256-GCM, ver common/cripto-secreto.ts) y nunca
/// vuelve al cliente: la API expone si está configurada y cuándo se cambió, no
/// el valor. La clave de cifrado vive en INTEGRACIONES_ENC_KEY, fuera de la base
/// — quien lea un backup no puede usar las credenciales.
model IntegracionCredencial {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  /// Proveedor: por ahora solo 'tokko'.
  proveedor      String
  /// Secreto cifrado, formato "iv.tag.ciphertext" en base64.
  secretoEnc     String   @map("secreto_enc")
  /// Últimos 4 caracteres en claro, para que el admin reconozca cuál cargó sin
  /// que la API tenga que devolver el secreto.
  ultimos4       String   @map("ultimos4")
  /// Quién la cargó por última vez, para poder preguntarle.
  actualizadoPor String?  @map("actualizado_por") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, proveedor])
  @@index([tenantId])
  @@map("integracion_credencial")
}

/// Propiedad publicada, espejo de lo que vive en Tokko.
///
/// Se trae leyendo la API de Tokko, que es lo único que se puede hacer sin
/// riesgo: escribir con el importador da de baja lo que no viaja en el archivo
/// (ver docs/CONVENCIONES_TECNICAS.md §12).
///
/// NO se guarda `real_address`. Tokko separa la dirección publicada de la real
/// —la del propietario— y para mostrar el catálogo alcanza la publicada.
model Propiedad {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  /// Id que asigna Tokko: el "DNI" de la propiedad.
  tokkoId       Int     @map("tokko_id")
  /// Identificador propio de la inmobiliaria dentro de Tokko. Es el campo por
  /// el que se hace el match al publicar (`reference_code` del importador).
  referenceCode String? @map("reference_code")

  titulo      String?
  tipo        String?
  operacion   String?
  precio      Decimal? @db.Decimal(14, 2)
  moneda      String?
  direccion   String?
  ubicacion   String?
  fotos       Int      @default(0)
  fotoPortada String?  @map("foto_portada")
  publicUrl   String?  @map("public_url")
  estado      String?

  /// Vendedor que la captó. Se resuelve por el email del `producer` de Tokko;
  /// queda en null cuando ese email no corresponde a ningún usuario nuestro.
  agenteId          String? @map("agente_id") @db.Uuid
  /// El email tal como vino de Tokko, aunque no haya matcheado. Sin esto no se
  /// puede ofrecer vincularlo después: se perdería a quién pertenece.
  agenteEmailTokko  String? @map("agente_email_tokko")
  agenteNombreTokko String? @map("agente_nombre_tokko")

  /// Fechas de Tokko, no las nuestras: `updated_at` es lo que el importador usa
  /// para decidir si una modificación se aplica o se ignora.
  creadoEnTokko DateTime? @map("creado_en_tokko") @db.Timestamptz(6)
  importadoEl   DateTime  @default(now()) @map("importado_el") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agente Usuario? @relation(fields: [agenteId], references: [id], onDelete: SetNull)

  @@unique([tenantId, tokkoId])
  @@index([tenantId])
  @@index([agenteId])
  @@map("propiedad")
}

model GoogleCuenta {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  usuarioId       String   @unique @map("usuario_id") @db.Uuid
  // Refresh token de Google encriptado (AES-256-GCM), formato iv:tag:ciphertext en base64.
  refreshTokenEnc String   @map("refresh_token_enc")
  // Email de la cuenta de Google vinculada, para mostrar cuál está conectada.
  googleEmail     String?  @map("google_email")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("google_cuenta")
}

// ============================================================================
// Módulo Protocolo 5 Semanas — seguimiento de la comercialización.
// Ver docs/MODULO_PROTOCOLO_5_SEMANAS.md. La ficha es 1:1 con una tasación
// Captada: la tasación NO cambia de estado (así no se tocan los KPIs de
// captación del Tasador); el estado comercial vive acá.
// ============================================================================

/// Comercialización de una propiedad captada, en 5 semanas.
model Protocolo {
  id         String @id @default(uuid()) @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid
  tasacionId String @unique @map("tasacion_id") @db.Uuid
  /// Responsable — copiado de la tasación al iniciar (define el alcance por rol).
  agenteId   String @map("agente_id") @db.Uuid

  /// Inicio de la comercialización = día en que se inició el protocolo.
  fechaInicio DateTime @map("fecha_inicio") @db.Date
  estado      String   @default("activa") // activa | archivada

  // Datos pedidos al iniciar (sugeridos desde la tasación)
  precioPublicado         Decimal?  @map("precio_publicado") @db.Decimal(14, 2)
  moneda                  String    @default("USD")
  propietarioNombre       String?   @map("propietario_nombre")
  propietarioTelefono     String?   @map("propietario_telefono")
  propietarioEmail        String?   @map("propietario_email")
  vencimientoAutorizacion DateTime? @map("vencimiento_autorizacion") @db.Date

  // Métricas comerciales (alimentan el embudo del informe)
  consultas            Int @default(0)
  consultasCalificadas Int @default(0) @map("consultas_calificadas")
  visitas              Int @default(0)
  interesadosActivos   Int @default(0) @map("interesados_activos")
  ofertas              Int @default(0)

  // Análisis de la semana 5
  devolucionesMercado String? @map("devoluciones_mercado")
  objeciones          String?
  recomendacion       String?
  decisionPropietario String? @map("decision_propietario")
  proximasAcciones    String? @map("proximas_acciones")

  // Cierre
  archivadoEn        DateTime? @map("archivado_en") @db.Date
  motivoArchivo      String?   @map("motivo_archivo") // vendida | retirada | vencida | otro
  observacionArchivo String?   @map("observacion_archivo")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tasacion Tasacion          @relation(fields: [tasacionId], references: [id], onDelete: Cascade)
  agente   Usuario           @relation(fields: [agenteId], references: [id], onDelete: Restrict)
  acciones ProtocoloAccion[]

  @@index([tenantId])
  @@index([tenantId, agenteId])
  @@index([tenantId, estado])
  @@map("protocolo")
}

/// Una acción del checklist, copiada de la plantilla al iniciar el protocolo.
/// El título se guarda (no se referencia) para que la ficha quede histórica
/// aunque la plantilla cambie más adelante.
model ProtocoloAccion {
  id          String @id @default(uuid()) @db.Uuid
  protocoloId String @map("protocolo_id") @db.Uuid
  tenantId    String @map("tenant_id") @db.Uuid

  semana Int
  orden  Int
  /// Slug estable de la plantilla (permite comparar entre protocolos).
  clave  String
  titulo String

  estado         String    @default("pendiente") // pendiente | en_proceso | realizada | no_corresponde
  fechaPrevista  DateTime? @map("fecha_prevista") @db.Date
  fechaRealizada DateTime? @map("fecha_realizada") @db.Date
  observaciones  String?
  resultado      String?
  evidencia      String?

  protocolo Protocolo @relation(fields: [protocoloId], references: [id], onDelete: Cascade)
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([protocoloId])
  @@map("protocolo_accion")
}

// ============================================================================
// Módulo Alquileres — administración de contratos de alquiler.
// Ver docs/specs/alquileres-fase-1.md (qué) y alquileres-fase-1-plan.md (cómo).
//
// Todas las tablas llevan tenant_id, aunque se pueda deducir del padre: la
// policy de RLS tiene que poder filtrar cada tabla sola.
//
// Los campos `*PorId` (quién confirmó, anuló, cargó) son uuid SIN clave
// foránea a `usuario` a propósito: son auditoría, y un usuario dado de baja no
// puede dejar huérfano —ni impedir borrar— un movimiento de plata.
// ============================================================================

/// Una persona del módulo: propietario, inquilino o garante. El papel no vive
/// acá sino en cada contrato (`AlqContratoParte`): la misma persona puede ser
/// propietaria de un contrato e inquilina de otro.
model AlqPersona {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  tipo      String   @default("fisica") // fisica | juridica
  nombre    String
  documento String? // DNI o CUIT, sin puntos ni guiones
  email     String?
  telefono  String?
  domicilio String?
  obs       String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  partes        AlqContratoParte[]
  conceptos     AlqConcepto[]
  cobros        AlqCobro[]
  liquidaciones AlqLiquidacion[]
  firmas        AlqFirmante[]

  @@unique([tenantId, documento])
  @@index([tenantId])
  @@map("alq_persona")
}

/// La unidad que se alquila. Tabla propia y no el modelo `Propiedad`, que es
/// el espejo de Tokko: una unidad alquilada puede no estar publicada. Si está,
/// `tokkoId` permite vincularlas.
model AlqPropiedad {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  direccion String
  unidad    String? // piso y depto, local, cochera
  ciudad    String?
  tipo      String? // vivienda | local | oficina | cochera | otro
  tokkoId   Int?     @map("tokko_id")
  obs       String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contratos AlqContrato[]

  @@index([tenantId])
  @@map("alq_propiedad")
}

model AlqContrato {
  id                 String    @id @default(uuid()) @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  codigo             String
  propiedadId        String    @map("propiedad_id") @db.Uuid
  tipo               String    @default("vivienda") // vivienda | comercial
  moneda             String    @default("ARS") // ARS | USD — todo el contrato va en esta moneda
  inicio             DateTime  @db.Date
  fin                DateTime  @db.Date
  fechaFirma         DateTime? @map("fecha_firma") @db.Date
  /// Día del mes en que vence el alquiler del inquilino (5 en Vacker) y día en
  /// que se le paga al propietario (10). En fin de semana se corren al lunes;
  /// los feriados no (regla 37, como Gexion).
  diaVencimiento     Int       @default(5) @map("dia_vencimiento")
  diaPagoPropietario Int       @default(10) @map("dia_pago_propietario")
  ajuste             String    @default("indexado") // indexado | escalonado
  indice             String? // ICL | IPC | CCP
  periodicidadMeses  Int?      @map("periodicidad_meses")
  honorariosPct      Decimal   @default(0) @map("honorarios_pct") @db.Decimal(5, 2)
  gastosAdmPct       Decimal   @default(0) @map("gastos_adm_pct") @db.Decimal(5, 2)
  ivaPct             Decimal   @default(0) @map("iva_pct") @db.Decimal(5, 2)
  punitorioDiarioPct Decimal   @default(0) @map("punitorio_diario_pct") @db.Decimal(6, 3)
  pagoGarantizado    Boolean   @default(false) @map("pago_garantizado")
  depositoImporte    Decimal?  @map("deposito_importe") @db.Decimal(14, 2)
  depositoMoneda     String?   @map("deposito_moneda")
  depositoDevolucion DateTime? @map("deposito_devolucion") @db.Date
  estado             String    @default("borrador") // borrador | vigente | finalizado | rescindido
  rescindidoEl       DateTime? @map("rescindido_el") @db.Date
  obs                String?
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  propiedad  AlqPropiedad       @relation(fields: [propiedadId], references: [id], onDelete: Restrict)
  partes     AlqContratoParte[]
  tramos     AlqTramo[]
  conceptos  AlqConcepto[]
  documentos AlqDocumento[]

  @@unique([tenantId, codigo])
  @@index([tenantId])
  @@index([tenantId, estado])
  @@map("alq_contrato")
}

/// Quién es quién en un contrato. `porcentaje` solo para propietarios, y entre
/// todos suman 100 (regla 4 de la spec).
model AlqContratoParte {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  contratoId String   @map("contrato_id") @db.Uuid
  personaId  String   @map("persona_id") @db.Uuid
  papel      String // propietario | inquilino | garante
  porcentaje Decimal? @db.Decimal(5, 2)

  tenant   Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contrato AlqContrato @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  persona  AlqPersona  @relation(fields: [personaId], references: [id], onDelete: Restrict)

  @@unique([contratoId, personaId, papel])
  @@index([tenantId])
  @@index([personaId])
  @@map("alq_contrato_parte")
}

/// Un período del contrato con su importe mensual. En un contrato indexado,
/// `importe` queda vacío hasta que alguien confirma la propuesta (reglas 5–6).
model AlqTramo {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  contratoId       String    @map("contrato_id") @db.Uuid
  numero           Int
  desde            DateTime  @db.Date
  hasta            DateTime  @db.Date
  importe          Decimal?  @db.Decimal(14, 2)
  indiceBase       Decimal?  @map("indice_base") @db.Decimal(18, 6)
  indiceRequerido  Decimal?  @map("indice_requerido") @db.Decimal(18, 6)
  importePropuesto Decimal?  @map("importe_propuesto") @db.Decimal(14, 2)
  confirmadoEl     DateTime? @map("confirmado_el") @db.Timestamptz(6)
  confirmadoPorId  String?   @map("confirmado_por_id") @db.Uuid

  tenant   Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contrato AlqContrato @relation(fields: [contratoId], references: [id], onDelete: Cascade)

  @@unique([contratoId, numero])
  @@index([tenantId])
  @@map("alq_tramo")
}

/// Lo que alguien debe, o lo que se le debe a alguien. La pieza central.
///
/// `claveGeneracion` es lo que hace idempotente la generación del período
/// (regla 10): los conceptos generados la llevan —contrato, persona, tipo y
/// período— y los cargados a mano la dejan vacía. La restricción única la
/// garantiza la base, no un `if` que se pueda saltear.
model AlqConcepto {
  id                        String    @id @default(uuid()) @db.Uuid
  tenantId                  String    @map("tenant_id") @db.Uuid
  contratoId                String?   @map("contrato_id") @db.Uuid
  personaId                 String    @map("persona_id") @db.Uuid
  tipo                      String // alquiler | gastos_adm | honorarios | iva | punitorio | expensa | impuesto | servicio | reparacion | saldo_inicial | otro
  sentido                   String // a_cobrar | a_pagar
  moneda                    String    @default("ARS")
  periodo                   String? // YYYY-MM
  vencimiento               DateTime  @db.Date
  importe                   Decimal   @db.Decimal(14, 2)
  adelantadoPorInmobiliaria Boolean   @default(false) @map("adelantado_por_inmobiliaria")
  liquidacionId             String?   @map("liquidacion_id") @db.Uuid
  origenId                  String?   @map("origen_id") @db.Uuid
  descripcion               String?
  claveGeneracion           String?   @map("clave_generacion")
  /// El cobro que lo creó: los punitorios nacen al cobrar (regla 16).
  cobroId                   String?   @map("cobro_id") @db.Uuid
  anuladoEn                 DateTime? @map("anulado_en") @db.Timestamptz(6)
  anuladoPorId              String?   @map("anulado_por_id") @db.Uuid
  motivoAnulacion           String?   @map("motivo_anulacion")
  createdAt                 DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contrato     AlqContrato?    @relation(fields: [contratoId], references: [id], onDelete: Restrict)
  persona      AlqPersona      @relation(fields: [personaId], references: [id], onDelete: Restrict)
  liquidacion  AlqLiquidacion? @relation(fields: [liquidacionId], references: [id], onDelete: SetNull)
  imputaciones AlqImputacion[]
  cobro        AlqCobro?       @relation("ConceptoDelCobro", fields: [cobroId], references: [id], onDelete: SetNull)

  @@unique([tenantId, claveGeneracion])
  @@index([tenantId])
  @@index([tenantId, personaId])
  @@index([tenantId, periodo])
  @@index([contratoId])
  @@index([cobroId])
  @@map("alq_concepto")
}

/// Plata que entra (de un inquilino) o sale. Nunca se borra: se anula (regla 19).
model AlqCobro {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  /// Número del recibo, correlativo por inmobiliaria.
  numero          Int
  personaId       String    @map("persona_id") @db.Uuid
  fecha           DateTime  @db.Date
  moneda          String    @default("ARS")
  importe         Decimal   @db.Decimal(14, 2)
  medio           String // transferencia | efectivo | cheque | otro
  obs             String?
  creadoPorId     String?   @map("creado_por_id") @db.Uuid
  anuladoEn       DateTime? @map("anulado_en") @db.Timestamptz(6)
  anuladoPorId    String?   @map("anulado_por_id") @db.Uuid
  motivoAnulacion String?   @map("motivo_anulacion")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  persona      AlqPersona      @relation(fields: [personaId], references: [id], onDelete: Restrict)
  imputaciones AlqImputacion[]
  /// Imputaciones hechas al registrar este cobro, incluidas las que usan el
  /// saldo a favor de cobros anteriores (regla 17).
  registradas  AlqImputacion[] @relation("ImputacionRegistradaEn")
  /// Conceptos que nacieron con este cobro: los punitorios (regla 16).
  conceptos    AlqConcepto[]   @relation("ConceptoDelCobro")

  @@unique([tenantId, numero])
  @@index([tenantId])
  @@index([tenantId, personaId])
  @@map("alq_cobro")
}

/// Cuánto de un cobro se aplicó a cada concepto. El saldo de un concepto es su
/// importe menos lo imputado; la cuenta corriente no es una tabla (ver el plan).
model AlqImputacion {
  id                  String  @id @default(uuid()) @db.Uuid
  tenantId            String  @map("tenant_id") @db.Uuid
  cobroId             String  @map("cobro_id") @db.Uuid
  conceptoId          String  @map("concepto_id") @db.Uuid
  importe             Decimal @db.Decimal(14, 2)
  /// En qué cobro se registró: otro que `cobroId` cuando se aplica saldo a favor.
  registradaEnCobroId String  @map("registrada_en_cobro_id") @db.Uuid

  tenant            Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cobro             AlqCobro    @relation(fields: [cobroId], references: [id], onDelete: Cascade)
  registradaEnCobro AlqCobro    @relation("ImputacionRegistradaEn", fields: [registradaEnCobroId], references: [id], onDelete: Cascade)
  concepto          AlqConcepto @relation(fields: [conceptoId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([cobroId])
  @@index([registradaEnCobroId])
  @@index([conceptoId])
  @@map("alq_imputacion")
}

/// Lo que se le paga a un propietario por un período, neto de honorarios y
/// gastos (reglas 20–22). Cada concepto apunta a la liquidación que lo saldó.
model AlqLiquidacion {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  /// Número correlativo por inmobiliaria.
  numero          Int
  personaId       String    @map("persona_id") @db.Uuid
  periodo         String // YYYY-MM
  moneda          String    @default("ARS")
  neto            Decimal   @db.Decimal(14, 2)
  fecha           DateTime  @db.Date
  medio           String    @default("transferencia") // transferencia | efectivo | cheque | otro
  /// Cada concepto con su importe, tal como se liquidó (ver la migración).
  detalle         Json
  creadoPorId     String?   @map("creado_por_id") @db.Uuid
  anuladoEn       DateTime? @map("anulado_en") @db.Timestamptz(6)
  anuladoPorId    String?   @map("anulado_por_id") @db.Uuid
  motivoAnulacion String?   @map("motivo_anulacion")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  persona   AlqPersona    @relation(fields: [personaId], references: [id], onDelete: Restrict)
  conceptos AlqConcepto[]

  @@unique([tenantId, numero])
  @@index([tenantId])
  @@index([tenantId, personaId])
  @@map("alq_liquidacion")
}

/// El documento de un contrato y su estado de firma (reglas 33–36). El
/// proveedor de firma queda detrás de una interfaz propia: acá solo se guarda
/// cuál fue y el identificador que devolvió.
model AlqDocumento {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  contratoId     String   @map("contrato_id") @db.Uuid
  archivo        String? // ruta en Storage
  nombreArchivo  String?  @map("nombre_archivo")
  /// El PDF firmado, cuando vuelve (regla 34).
  archivoFirmado String?  @map("archivo_firmado")
  estadoFirma    String   @default("sin_enviar") @map("estado_firma") // sin_enviar | enviado | firmado_parcial | firmado | rechazado | vencido
  proveedor      String? // manual | <nombre del proveedor>
  envioExternoId String?  @map("envio_externo_id")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contrato  AlqContrato      @relation(fields: [contratoId], references: [id], onDelete: Restrict)
  firmantes AlqFirmante[]
  eventos   AlqFirmaEvento[]

  @@unique([contratoId])
  @@unique([proveedor, envioExternoId])
  @@index([tenantId])
  @@index([contratoId])
  @@map("alq_documento")
}

model AlqFirmante {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  documentoId String    @map("documento_id") @db.Uuid
  personaId   String    @map("persona_id") @db.Uuid
  estado      String    @default("pendiente") // pendiente | firmado | rechazado
  firmadoEl   DateTime? @map("firmado_el") @db.Timestamptz(6)

  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  documento AlqDocumento @relation(fields: [documentoId], references: [id], onDelete: Cascade)
  persona   AlqPersona   @relation(fields: [personaId], references: [id], onDelete: Restrict)

  @@unique([documentoId, personaId])
  @@index([tenantId])
  @@index([documentoId])
  @@map("alq_firmante")
}

/// Cada cambio de estado de firma, con su origen (regla 34). Solo se agrega.
model AlqFirmaEvento {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  documentoId    String   @map("documento_id") @db.Uuid
  fecha          DateTime @default(now()) @db.Timestamptz(6)
  estadoAnterior String?  @map("estado_anterior")
  estadoNuevo    String   @map("estado_nuevo")
  origen         String // manual | <nombre del proveedor>
  detalle        Json?

  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  documento AlqDocumento @relation(fields: [documentoId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([documentoId])
  @@map("alq_firma_evento")
}

/// Valores del ICL (BCRA) y del IPC (INDEC). Sin tenant_id a propósito: son
/// datos públicos, iguales para todas las inmobiliarias. RLS de solo lectura;
/// la escribe el importador diario (spec alquileres, regla 8).
model IndiceValor {
  indice    String // ICL | IPC
  /// ICL: el día. IPC: el primer día del mes.
  fecha     DateTime @db.Date
  valor     Decimal  @db.Decimal(18, 6)
  fuente    String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([indice, fecha])
  @@map("indice_valor")
}
