# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
build/
.next/
out/
*.tsbuildinfo

# Turborepo
.turbo/

# Env / secrets — NUNCA commitear .env reales
.env
.env.*
!.env.example

# Test / coverage
coverage/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# OS / editor
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# Claude Code — settings personales/locales (launch.json sí se comparte)
.claude/settings.local.json

# Playwright
playwright-report/
test-results/

# PDF generados de la documentación del panel
apps/web/pdf/

# Perfil del navegador que saca las capturas del sitio (tiene la sesión)
apps/sitio/.perfil-capturas/

# Build de los tests de navegador del sitio (separado para no pisar `next dev`)
apps/sitio/.next-e2e/

# Generado por Next en cada build. En apps/sitio hay DOS directorios de build
# (.next y .next-e2e) y este archivo apunta al último que se usó, así que
# rastrearlo dejaría el árbol sucio cada vez que se corren los tests de
# navegador. `typecheck` no lo necesita.
apps/sitio/next-env.d.ts

# Copias de la base de producción. Tienen datos reales de clientes: no entran
# al repositorio ni por accidente. Van a ~/Respaldos-Inmobiliaria/.
Respaldos-Inmobiliaria/
*.respaldo.json

# La presentación se GENERA; lo que se versiona es el script que la arma.
scripts/comercial/*.pptx
scripts/comercial/node_modules/
scripts/comercial/previa/
