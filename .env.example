# =============================================================================
# .env.example — Inmobiliaria Inteligente 2.0 (Vacker)
# Copiá este archivo a .env y completá los valores. NUNCA commitees .env.
# En el Paso 1 (Fundaciones) solo se usan API_PORT y NEXT_PUBLIC_API_URL.
# El resto son placeholders para el Paso 2 (núcleo backend / Supabase).
# =============================================================================

# --- Backend / Supabase: PostgreSQL (Prisma) --------------------------------
# DATABASE_URL: conexión POOLED (pgbouncer, puerto 6543). La usa la app en runtime.
# DIRECT_URL:   conexión DIRECTA (puerto 5432). La usa Prisma para migraciones.
# Ambas salen del botón "Connect" del panel de Supabase (pestaña ORMs).
# Reemplazá [YOUR-PASSWORD] por la contraseña de la base.
DATABASE_URL=
DIRECT_URL=

# --- Backend / Supabase: Auth + Storage -------------------------------------
# SUPABASE_URL = https://<project-id>.supabase.co
SUPABASE_URL=
# anon / public key (se puede exponer al cliente)
SUPABASE_ANON_KEY=
# service_role / secret key: SECRETA, salta RLS. SOLO backend, nunca en el front.
SUPABASE_SERVICE_ROLE_KEY=

# --- API (apps/api) ----------------------------------------------------------
# Puerto del backend NestJS
API_PORT=3001
# CORS: orígenes extra permitidos (coma-separados). El dominio propio, *.vercel.app
# y localhost ya están permitidos por default — esto es para agregar otros.
# CORS_ORIGINS=https://otro-dominio.com,https://staging.ejemplo.com

# --- Web (apps/web) ----------------------------------------------------------
# URL base de la API que consume el frontend
NEXT_PUBLIC_API_URL=http://localhost:3001
# Mismo proyecto Supabase que el backend (NEXT_PUBLIC_* se expone al browser;
# la anon key está pensada para eso, nunca pongas acá la service_role key).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Recupero de contraseña self-service ("¿Olvidaste tu contraseña?" en el login).
# Vacío/0 = la pantalla le dice al usuario que le pida una clave temporal al
# administrador (funciona sin configurar nada). Poner 1 SOLO después de
# configurar un proveedor de SMTP en Supabase (Auth → Emails): sin eso, el
# correo no llega y el usuario queda esperando.
NEXT_PUBLIC_RECUPERO_POR_EMAIL=

# Cifrado de credenciales de integraciones (API key de Tokko por inmobiliaria).
# 32 bytes en base64:  openssl rand -base64 32
INTEGRACIONES_ENC_KEY=

# Envío de mails (Resend). Se usa en dos lugares: el reporte semanal del
# Protocolo (apps/api) y el formulario de contacto del sitio comercial
# (apps/sitio). Son dos despliegues distintos —Render y Vercel—, así que la
# variable hay que cargarla en LOS DOS; con la misma clave alcanza.
# La clave se crea en resend.com → API Keys, con permiso SOLO de envío
# ("Sending access"): si se filtra, no puede borrar el dominio ni crear otras.
# El dominio avisos.inmobiliariainteligente.net ya está verificado.
# Sin esta variable el formulario del sitio responde 500 y la consulta se
# pierde: falla ruidosa a propósito, para que no queden prospectos en el aire.
RESEND_API_KEY=

# Base de la web, para los links dentro del mail. Sin esto se usa
# https://app.inmobiliariainteligente.net.
WEB_URL=

# Secreto compartido con el cron de GitHub Actions que manda el reporte
# semanal (.github/workflows/reporte-semanal.yml). Tiene que estar cargado
# en Render Y como secret del repositorio, con el mismo valor.
# Generar uno con:  openssl rand -hex 32
# Sin esta variable el endpoint /tareas/reporte-semanal responde 401 — falla
# cerrada a propósito: mejor que la tarea no corra a que quede abierta.
CRON_SECRET=
