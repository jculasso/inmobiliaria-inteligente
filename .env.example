# =============================================================================
# .env.example — Inmobiliaria Inteligente 2.0 (Vacker)
# Copiá este archivo a .env y completá los valores. NUNCA commitees .env.
# En el Paso 1 (Fundaciones) solo se usan API_PORT y NEXT_PUBLIC_API_URL.
# El resto son placeholders para el Paso 2 (núcleo backend / Supabase).
# =============================================================================

# --- Backend / Supabase: PostgreSQL (Prisma) --------------------------------
# DATABASE_URL: conexión POOLED (pgbouncer, puerto 6543). La usa la app en runtime.
# DIRECT_URL:   conexión DIRECTA (puerto 5432). La usa Prisma para migraciones.
# Ambas salen del botón "Connect" del panel de Supabase (pestaña ORMs).
# Reemplazá [YOUR-PASSWORD] por la contraseña de la base.
DATABASE_URL=
DIRECT_URL=

# --- Backend / Supabase: Auth + Storage -------------------------------------
# SUPABASE_URL = https://<project-id>.supabase.co
SUPABASE_URL=
# anon / public key (se puede exponer al cliente)
SUPABASE_ANON_KEY=
# service_role / secret key: SECRETA, salta RLS. SOLO backend, nunca en el front.
SUPABASE_SERVICE_ROLE_KEY=

# --- API (apps/api) ----------------------------------------------------------
# Puerto del backend NestJS en local. En Render manda PORT, que lo asigna la
# plataforma (no hace falta cargarlo a mano).
API_PORT=3001
# NODE_ENV=production en Render: apaga /docs y marca Secure la cookie del flujo
# de Google. En local se deja vacío (development).
NODE_ENV=
# CORS: orígenes extra permitidos (coma-separados). Ya están permitidos por
# default el dominio propio, localhost y las previews de Vercel de ESTE
# proyecto (inmobiliaria-inteligente-web-* / inmobiliaria-inteligente-sitio-* y
# las que terminan en -inmobiliaria-inteligente.vercel.app, el sufijo del equipo).
# Cualquier otro *.vercel.app ya NO pasa: agregarlo acá si hace falta.
# CORS_ORIGINS=https://otro-dominio.com,https://staging.ejemplo.com

# Límite de pedidos por minuto y por persona en toda la API (vacío = 120). Las
# rutas costosas (PDF, exportación, mails, Tokko) tienen además su propio tope
# fijo en el código. Ver apps/api/src/common/limite-solicitudes.ts.
THROTTLE_LIMITE_MINUTO=
# Cuántos proxies hay delante de la API (vacío = 1, el de Render). Define de
# dónde sale la IP real del cliente. NO poner un número mayor al real: cada
# salto de más deja que el cliente elija su IP con un X-Forwarded-For propio.
TRUST_PROXY_SALTOS=

# --- To Do List (Google Calendar, apps/api) ----------------------------------
# Opcionales: sin ellas la API arranca igual y solo el To Do avisa que no está
# configurado. Salen de Google Cloud Console → APIs y servicios → Credenciales
# (cliente OAuth de tipo «Aplicación web»).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# El callback vive en la API, no en la web:
#   https://api.inmobiliariainteligente.net/todo/google/callback
# Tiene que figurar igual en «URIs de redireccionamiento autorizados». El paso
# intermedio /todo/google/iniciar se arma a partir de esta misma URL.
GOOGLE_OAUTH_REDIRECT_URI=
# Cifra los refresh tokens de Google en la base Y el `state` del flujo.
# 32 bytes en base64:  openssl rand -base64 32
# Tiene que ser la MISMA en todos los entornos que compartan la base: si
# cambia, los calendarios conectados dejan de leerse y hay que reconectarlos.
GOOGLE_TOKEN_ENC_KEY=
# Base de la web, para volver a /todo después de conectar Google (y para el
# aviso de error si algo falla). Sin esto se vuelve a http://localhost:3000.
WEB_APP_URL=

# --- Web (apps/web) ----------------------------------------------------------
# URL base de la API que consume el frontend
NEXT_PUBLIC_API_URL=http://localhost:3001
# Mismo proyecto Supabase que el backend (NEXT_PUBLIC_* se expone al browser;
# la anon key está pensada para eso, nunca pongas acá la service_role key).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Recupero de contraseña self-service ("¿Olvidaste tu contraseña?" en el login).
# Vacío/0 = la pantalla le dice al usuario que le pida una clave temporal al
# administrador (funciona sin configurar nada). Poner 1 SOLO después de
# configurar un proveedor de SMTP en Supabase (Auth → Emails): sin eso, el
# correo no llega y el usuario queda esperando.
NEXT_PUBLIC_RECUPERO_POR_EMAIL=

# Cifrado de credenciales de integraciones (API key de Tokko por inmobiliaria).
# 32 bytes en base64:  openssl rand -base64 32
INTEGRACIONES_ENC_KEY=

# Envío de mails (Resend). Se usa en dos lugares: el reporte semanal del
# Protocolo (apps/api) y el formulario de contacto del sitio comercial
# (apps/sitio). Son dos despliegues distintos —Render y Vercel—, así que la
# variable hay que cargarla en LOS DOS; con la misma clave alcanza.
# La clave se crea en resend.com → API Keys, con permiso SOLO de envío
# ("Sending access"): si se filtra, no puede borrar el dominio ni crear otras.
# El dominio avisos.inmobiliariainteligente.net ya está verificado.
# Sin esta variable el formulario del sitio responde 500 y la consulta se
# pierde: falla ruidosa a propósito, para que no queden prospectos en el aire.
RESEND_API_KEY=

# A quién le llegan las consultas del formulario del sitio comercial
# (apps/sitio, SOLO en Vercel). Casillas separadas por coma. Antes estaban
# escritas en el código, y el repositorio es público. Sin esta variable el
# formulario responde 500, igual que sin RESEND_API_KEY: falla ruidosa.
# CONTACTO_DESTINOS=direccion@ejemplo.com,ventas@ejemplo.com
CONTACTO_DESTINOS=

# Base de la web, para los links dentro del mail. Sin esto se usa
# https://app.inmobiliariainteligente.net.
WEB_URL=

# Secreto compartido con el cron de GitHub Actions que manda el reporte
# semanal (.github/workflows/reporte-semanal.yml). Tiene que estar cargado
# en Render Y como secret del repositorio, con el mismo valor.
# Generar uno con:  openssl rand -hex 32
# Sin esta variable el endpoint /tareas/reporte-semanal responde 401 — falla
# cerrada a propósito: mejor que la tarea no corra a que quede abierta.
CRON_SECRET=

# La documentación OpenAPI (/docs) no se publica en producción: mostraba el
# mapa entero de rutas. «true» la prende para revisarla; en local siempre está.
DOCS_PUBLICOS=

# --- Alquileres: firma del contrato (regla 35) ---
# Qué proveedor de firma electrónica usa el módulo. Vacío o «manual»: no hay
# proveedor; la inmobiliaria manda el PDF por su cuenta y marca quién firmó.
# Sumar uno es escribir su adaptador (apps/api/src/modules/alquileres/firma/)
# y poner acá su nombre. Sus avisos llegan a POST /webhooks/firma/<nombre>.
FIRMA_PROVEEDOR=
